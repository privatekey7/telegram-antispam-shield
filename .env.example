# --- Required ---------------------------------------------------------------
# Bot token from @BotFather (https://t.me/BotFather).
BOT_TOKEN=123456:ABC-DEF_your_token_here

# --- Optional behaviour -----------------------------------------------------
# What to do with a spammer: delete (default) | ban | mute
ANTISPAM_ACTION=delete

# Try the bot without deleting anything — only logs what it WOULD delete.
ANTISPAM_DRY_RUN=false

# Override the model's spam probability threshold (0.0 - 1.0).
# Higher = stricter about calling something spam (fewer deletions).
# Leave unset to use the tuned default baked into the model.
# ANTISPAM_THRESHOLD=0.85

# Treat Telegram invite links (t.me/+..., joinchat) as spam.
ANTISPAM_BLOCK_INVITE_LINKS=true

# Treat job and income offers as spam ("remote work, 300$ a day, DM me"):
# work/income wording plus an amount of money or a request to write in private.
ANTISPAM_BLOCK_JOB_OFFERS=true

# Treat invisible characters inside words ("act<zero-width space>ive") as spam.
ANTISPAM_BLOCK_HIDDEN_CHARACTERS=true

# Treat inline buttons on a member's message as spam. People can't attach
# buttons; business bots and other automation can.
ANTISPAM_BLOCK_INLINE_KEYBOARDS=true

# Never moderate group administrators. Posts of the group itself (anonymous
# admins, the linked channel) are always exempt.
ANTISPAM_EXEMPT_ADMINS=true

# How long (seconds) to cache each group's admin list and rights. Commands and
# report buttons always re-check the admin's current rights with Telegram.
ANTISPAM_ADMIN_CACHE_TTL=3600

# --- Trust and history -------------------------------------------------------
# A member is trusted after this many clean messages: the model, job-offer and
# newcomer-link checks stop for them. 0 = check everyone.
ANTISPAM_TRUST_AFTER=3
# Shorter messages ("+", "hi") don't count toward trust.
ANTISPAM_TRUST_MIN_CHARS=10
# Trust lapses after this many days without a clean message. 0 = never.
ANTISPAM_TRUST_TTL_DAYS=90

# Spam: a link from someone who joined recently and hasn't talked yet.
ANTISPAM_BLOCK_NEWCOMER_LINKS=true
# Spam: the same long text from several untrusted accounts. Earlier copies go
# too once three accounts have posted it.
ANTISPAM_BLOCK_CAMPAIGNS=true
# Spam: one member posting the same text this many times a day. 0 = off.
ANTISPAM_REPEAT_LIMIT=3
# How long (seconds) messages and joins are remembered for these rules.
ANTISPAM_HISTORY_WINDOW_SECS=86400
# With ACTION=ban or mute, also delete the spammer's other recent messages.
ANTISPAM_CLEANUP_ON_BAN=true

# Folder for antispam.db (trusted members, learned samples, warnings and reports
# survive restarts). The Docker image uses /data; leave unset elsewhere to keep
# state in memory only.
# ANTISPAM_DATA_DIR=./data

# --- Shape checks and CAS ---------------------------------------------------
# Messages shorter than this and without links skip the model.
ANTISPAM_MODEL_MIN_CHARS=20
# Spam: a message that is only a bot's @username (business-bot spam trigger).
ANTISPAM_BLOCK_BOT_MENTIONS=true
# Spam: this many words mixing Cyrillic and Latin letters. 0 = off.
ANTISPAM_MIXED_SCRIPT_WORDS=2
# Spam: this many emoji in one message. 0 = off.
ANTISPAM_EMOJI_LIMIT=10

# Look up untrusted members in the Combot Anti-Spam database (cas.chat).
# Sends their numeric user ID to api.cas.chat. After a failed lookup CAS is
# skipped for a minute.
ANTISPAM_CAS_ENABLED=true
ANTISPAM_CAS_TIMEOUT_SECS=5
# ANTISPAM_CAS_URL=https://api.cas.chat

# Opt-in checks for untrusted members:
# ANTISPAM_BLOCKED_SCRIPTS=chinese,arabic
# ANTISPAM_STOP_WORDS=казино,быстрый заработок
# ANTISPAM_BLOCK_FORWARDS=true
# ANTISPAM_LINK_LIMIT=3
# ANTISPAM_MENTION_LIMIT=5

# Delete "X joined" / "X left" notices.
ANTISPAM_DELETE_SERVICE_MESSAGES=false

# --- Admin tools -------------------------------------------------------------
# Reports about deleted spam, with "Not spam" / "Ban" buttons, go to this chat.
# Unset: they go to ANTISPAM_OWNER_ID in private (press Start in the bot first).
# ANTISPAM_REPORT_CHAT=-1001234567890
# /warn count within a month that leads to a ban. 0 = never.
ANTISPAM_WARN_LIMIT=3
# How similar (0-1) a message must be to a /spam-ed one to be deleted.
ANTISPAM_SIMILARITY_THRESHOLD=0.5

# --- Access control ---------------------------------------------------------
# The chats the bot moderates: comma-separated numeric chat IDs (groups are
# negative, e.g. -1001234567890). Unset = NO chat is moderated: the bot only
# logs "chat_not_allowed chat=<id>" for each group it sees, so you can copy
# your group's ID here. Every bot's username is public; this list keeps
# strangers who add your bot from using your hosting and sending you reports.
# An entry that is not a number (e.g. @mygroup) stops the bot at startup.
# ANTISPAM_ALLOWED_CHATS=-1001234567890,-1009876543210

# Moderate EVERY group the bot is added to when the list above is unset (the
# behaviour before 0.3). Not recommended for a private bot.
# ANTISPAM_ALLOW_ALL_CHATS=false

# When true, the bot immediately leaves any chat NOT in ANTISPAM_ALLOWED_CHATS.
# Set the list first, or it leaves your group too. Default: false (ignore).
ANTISPAM_LEAVE_UNKNOWN_CHATS=false

# Your Telegram numeric user ID. Only YOU see the /status details in a private
# chat with the bot; anyone else (everyone, when unset) only learns that it is
# running. The owner may also use commands and report buttons in any allowed
# chat. Find it via @userinfobot.
# ANTISPAM_OWNER_ID=123456789

# --- Anti-flood -------------------------------------------------------------
# Stops users who post too fast or repeat the same message: deletes the burst
# and mutes them. Muting needs the "Ban users" admin right.
ANTISPAM_FLOOD_ENABLED=true

# Flood when a user sends MORE than this many messages within the window.
# An album (media group) counts as one message.
ANTISPAM_FLOOD_MAX_MESSAGES=6
ANTISPAM_FLOOD_WINDOW_SECS=10

# Flood when this many messages with the same normalized text arrive within
# the window (case, punctuation and stretched letters are ignored).
ANTISPAM_FLOOD_MAX_DUPLICATES=3
ANTISPAM_FLOOD_DUPLICATE_WINDOW_SECS=120

# Mute length for the 1st, 2nd, 3rd... offence; the last step repeats.
ANTISPAM_FLOOD_MUTE_STEPS=10m,1h,1d

# Offence counter resets after this many seconds without a new offence.
ANTISPAM_FLOOD_STRIKE_RESET_SECS=86400

# Post a short "muted for flooding" notice, deleted after N seconds.
ANTISPAM_FLOOD_NOTIFY=true
ANTISPAM_FLOOD_NOTIFY_TTL_SECS=30

# Log verbosity: error | warn | info | debug | trace
RUST_LOG=info

# --- Advanced ---------------------------------------------------------------
# Path to a custom-trained model. Leave unset to use the built-in model.
# MODEL_PATH=/app/model/spam_model.bin

# Heartbeat file behind the image HEALTHCHECK (docs/hosting.md#health).
# ANTISPAM_HEARTBEAT_FILE=/tmp/antispam-heartbeat
